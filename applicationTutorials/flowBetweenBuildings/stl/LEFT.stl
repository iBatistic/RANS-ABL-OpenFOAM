solid left
  facet normal 0 1 -0
    outer loop
      vertex 515 -2.5 300
      vertex 515 -2.5 0
      vertex -250 -2.5 0
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 515 -2.5 300
      vertex -250 -2.5 0
      vertex -250 -2.5 300
    endloop
  endfacet
endsolid left
