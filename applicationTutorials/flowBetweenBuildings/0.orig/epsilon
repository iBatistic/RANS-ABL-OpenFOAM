FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

#include        "include/ABLConditions"

internalField   uniform $epsilonInit;

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletEpsilon;
        #include        "include/ABLConditions"
        value           uniform 0;
    }

    bottom
    {
        type            atmEpsilonWallFunction;
        Cmu             $Cmu;
        kappa           $kappa;
        z0              $z0;
        value           $internalField;
    }

    building
    {
        type            epsilonWallFunction;
        value           $internalField;
    }

    top
    {
        type            fixedValue;
        value           uniform $topEpsilon;

        // An alternative if the height of the domain is sufficient
        //type            zeroGradient;
    }

    left
    {
        type            symmetry;
    }

        right
    {
        type            symmetry;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
}


