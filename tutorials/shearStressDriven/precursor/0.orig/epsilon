FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

#include        "include/ABLConditions"

internalField   uniform $epsilonInit;

boundaryField
{
    inlet
    {
        type           zeroGradient;
    }

    ground
    {
        type            atmEpsilonWallFunction;
        Cmu             $Cmu;
        kappa           $kappa;
        z0	        $z0;
        value           $internalField;
    }

    top
    {
        type            fixedValue;
        value		uniform $topEpsilon;

        // An alternative if the height of the domain is sufficient
        //type            zeroGradient;
    }

    sides
    {
        type            empty;
    }

    outlet
    {
        type            zeroGradient;
    }
}


