FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver           GAMG;
        smoother         GaussSeidel;
        tolerance        1e-8;
        relTol           0.01;
    }

    "(U|k|epsilon|omega)"
    {
        solver           smoothSolver;
        smoother         GaussSeidel;
        tolerance        1e-8;
        relTol           0.01;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent               false;
    //pRefCell                 0;
    //pRefValue                0;
    
    //residualControl
    //{
    //    p               1e-5;
    //    U               1e-7;
    //    "(k|omega|epsilon)"   1e-7;
    //}

}

relaxationFactors
{

    fields
    {
        p               0.3;
    }
    equations
    {
        U                    0.7;
        "(k|epsilon|omega)"  0.7;
    }
    
//    equations
//    {
//        U                    0.9;
//        "(k|epsilon|omega)"  0.7;
//    }
}

cache
{
    grad(U);
}


