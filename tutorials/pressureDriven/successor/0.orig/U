FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

#include        "include/ABLConditions"

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletVelocityPD;
        #include        "include/ABLConditions"
        value           uniform (0 0 0);
    }

    ground
    {
        type            noSlip;
    }

    top
    {
        type            fixedValue;
        value           $topVelocity;
    }

    sides
    {
        type            empty;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }
}


