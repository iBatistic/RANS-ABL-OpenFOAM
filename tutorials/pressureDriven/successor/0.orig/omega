FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

#include        "include/ABLConditions"

internalField   uniform $omegaInit;

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletOmegaPD;
        #include        "include/ABLConditions"
        value           uniform 0;
    }

    ground
    {
        type            atmOmegaWallFunction;
        Cmu             $Cmu;
        kappa           $kappa;
        z0	        $z0;
        value           $internalField;
    }

    top
    {
        //type            fixedValue;
        //value		uniform $topOmega;
        
    	// An alternative if the height of the domain is sufficient
        type            zeroGradient;
    }

    sides
    {
        type            empty;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
}


