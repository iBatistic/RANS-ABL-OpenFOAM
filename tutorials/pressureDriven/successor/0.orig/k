FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

 #include      "include/ABLConditions"
 
internalField   uniform $kInit;

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletKPD;
        #include        "include/ABLConditions"
        value           uniform 0;
    }

    ground
    {
        type            kqRWallFunction;
        value           uniform $kInit;
    }

    top
    {
        //type            fixedValue;
        //value		uniform $topK;
        
        // An alternative if the height of the domain is sufficient
        type            zeroGradient;
    }

    sides
    {
        type            empty;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
}


